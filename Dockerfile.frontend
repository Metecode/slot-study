# Frontend imajı: Vite derlemesi + statik dosya sunan nginx.
# TLS ve /api, /oauth2, /login yönlendirmesi host'taki nginx'te; bu konteyner
# yalnızca derlenmiş dosyaları 80'den sunar (compose 127.0.0.1:8081'e bağlar).

# ---- Derleme aşaması ----
FROM node:22-alpine AS build
WORKDIR /app

# Bağımlılık katmanı yalnızca lock dosyası değişince yeniden kurulur.
COPY package.json package-lock.json ./
RUN npm ci

# Derleme için gereken dosyalar tek tek sayılıyor; backend/ gibi ilgisiz
# dizinler bağlama girse de imaja kopyalanmıyor.
COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY public public
COPY src src
COPY privacy privacy

# Alt bilgideki commit kısaltması için; vite.config.ts okuyor. Verilmezse
# boş kalır ve alt bilgi "dev" yazar.
ARG GITHUB_SHA
ENV GITHUB_SHA=$GITHUB_SHA
RUN npm run build

# ---- Sunma aşaması ----
FROM nginx:alpine

# İmajın varsayılan sitesini SPA yapılandırmasıyla değiştiriyoruz.
COPY deploy/nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
