{
  /*
    Geliştirme araçları: Node'da doğrudan çalışan betikler ve Capacitor
    yapılandırması. Production derlemesine girmez (Dockerfile.frontend
    bunları kopyalamıyor); tipleri npm run typecheck kontrol ediyor.
  */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["capacitor.config.ts", "scripts/**/*.ts"],
  /* src/domain'i import ediyor; kendi ayarıyla tsconfig.content-check.json'da */
  "exclude": ["scripts/content-check.ts", "scripts/content-check/**"]
}
