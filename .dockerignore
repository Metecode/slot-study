# Bağlam artık repo kökü (backend Docker build'i src/content/tr'yi de
# görebilsin diye); frontend'in build çıktısı ve bağımlılıkları bağlamı
# şişirmesin diye burada dışlanıyor.
node_modules
dist
dist-ssr
coverage
.git

# Backend tarafında zaten var olan yerel derleme çıktısı; imaj içinde
# yeniden derleniyor.
backend/target
backend/.mvn/wrapper/maven-wrapper.jar

# Geliştirme araçları, belgeler ve native projeler. İki Dockerfile da
# bunları kullanmıyor: frontend dosyaları tek tek sayıyor, backend yalnızca
# backend/ ve src/content/tr'yi kopyalıyor. Dışlanmaları, ileride yazılacak
# geniş bir COPY'nin (ör. `COPY . .`) bunları imaja taşımasını engeller.
android
ios
docs
scripts

.env
.env.local
.idea
.vscode
*.log
